# 팀 공용 환경변수 템플릿입니다.
# `cp .env.example .env` 후 .env에서만 실제 값을 채우세요.

SPRING_PROFILES_ACTIVE=local

# Supabase Dashboard > Connect > Shared Pooler > Session mode (port 5432)
SUPABASE_DB_URL='jdbc:postgresql://[POOLER-HOST]:5432/postgres?sslmode=require'
SUPABASE_DB_USERNAME='postgres.[PROJECT-REF]'
SUPABASE_DB_PASSWORD='[YOUR-PASSWORD]'

# Slack OAuth
SLACK_CLIENT_ID='[SLACK-CLIENT-ID]'
SLACK_CLIENT_SECRET='[SLACK-CLIENT-SECRET]'
SLACK_ALLOWED_TEAM_ID='T089ENT4A2D'
SLACK_REDIRECT_URI='http://localhost:8080/api/auth/slack/callback'

SESSION_COOKIE_SECURE=false
