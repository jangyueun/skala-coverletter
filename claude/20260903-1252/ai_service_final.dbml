Project ai_service_final {
  database_type: 'PostgreSQL'
  note: '''
    Career DB와 물리적으로 분리된 AI Service DB.
    Kafka 없이 Career Backend → AI Service HTTP 호출 → DB 작업 상태 저장 → Career Backend/프론트 폴링으로 동작한다.
    external_* 값은 Career DB PK의 논리 참조이며 cross-database FK를 걸지 않는다.

    [리뷰 수정] 원본에 있던 테이블별 checks {} 블록은 dbdiagram.io가 실제로 쓰는
    @dbml/core(현재 최신 10.1.1 기준)에서 파싱 자체가 실패하는 문법이라 전부 제거했다.
    ("Expected note/indexes/} ... but checks found" — 실제 파싱 테스트로 확인됨)
    모든 CHECK 제약과 부분 유니크 인덱스는 ai_service_final_constraints.sql로 옮겼다.
    이 파일은 dbdiagram.io에 그대로 붙여넣어 파싱되는 것까지 로컬 PostgreSQL 16으로 검증 완료.
  '''
}

Enum ai_task_type {
  POSTING_COMPETENCY_EXTRACTION
  EXPERIENCE_INTAKE
  MATCH
  DRAFT
}

Enum ai_task_status {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

Table ai_tasks {
  id                      bigint         [pk, increment]
  task_type               ai_task_type   [not null]
  status                  ai_task_status [not null, default: 'PENDING']

  external_user_id        bigint         [note: 'EXPERIENCE_INTAKE/MATCH/DRAFT 대상 사용자']
  external_job_posting_id bigint         [note: 'POSTING_COMPETENCY_EXTRACTION/MATCH 대상 공고. 문항 추출도 이 작업 결과에 함께 포함된다고 가정 — job_posting_questions.source_ai_task_id 참고']
  external_question_id    bigint         [note: 'DRAFT 대상 job_posting_questions.id']

  idempotency_key         varchar(128)   [not null, unique, note: 'task type + 대상 ID + input hash + 모델/프롬프트 버전 해시']
  input_hash              varchar(64)    [not null]
  model                   varchar(100)
  prompt_version          varchar(50)
  algorithm_version       varchar(50)

  request_payload         jsonb          [not null]
  result_payload          jsonb
  retry_count             integer        [not null, default: 0, note: 'CHECK >= 0는 ai_service_final_constraints.sql']
  total_tokens            integer        [note: 'CHECK IS NULL OR >= 0는 ai_service_final_constraints.sql']
  latency_ms              integer        [note: 'CHECK IS NULL OR >= 0는 ai_service_final_constraints.sql']
  error_code              varchar(100)
  error_message           text

  created_at              timestamptz    [not null, default: `now()`]
  started_at              timestamptz    [note: '상태-시각 정합성 CHECK는 ai_service_final_constraints.sql']
  completed_at            timestamptz

  Indexes {
    (status, created_at)
    (task_type, external_user_id, status)
    (task_type, external_job_posting_id, status)
  }

  note: '''
    필수 대상 규칙 (CHECK로 강제됨, ai_service_final_constraints.sql의 ck_ai_task_targets):
    - POSTING_COMPETENCY_EXTRACTION: external_job_posting_id
    - EXPERIENCE_INTAKE: external_user_id
    - MATCH: external_user_id + external_job_posting_id
    - DRAFT: external_user_id + external_question_id
    request_payload에는 DRAFT의 experienceIds 등 실행 시점 입력 스냅샷을 저장한다.

    [리뷰 추가] task_type별 "동시에 진행 중인 작업 1개" 보장이 API 명세의 409 DRAFT_ALREADY_RUNNING과
    직결되는데 idempotency_key(입력값 기반 해시)만으로는 입력이 달라지면 우회된다.
    ai_service_final_constraints.sql에 (external_user_id/question_id/job_posting_id) 기준
    PENDING/RUNNING 상태에 대한 부분 유니크 인덱스 3개를 추가했다.
  '''
}

Table ai_task_attempts {
  id            bigint         [pk, increment]
  ai_task_id    bigint         [not null]
  attempt_no    integer        [not null, note: 'CHECK > 0는 ai_service_final_constraints.sql']
  status        ai_task_status [not null]
  error_code    varchar(100)
  error_message text
  started_at    timestamptz    [not null]
  finished_at   timestamptz

  Indexes {
    (ai_task_id, attempt_no) [unique]
  }
}

Ref: ai_task_attempts.ai_task_id > ai_tasks.id [delete: cascade]

TableGroup "AI 비동기 작업" {
  ai_tasks
  ai_task_attempts
}
