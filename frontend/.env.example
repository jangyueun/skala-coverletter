# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
# ⚠ VITE_ 접두사를 붙이지 마세요.
#   Vite 는 VITE_ 로 시작하는 변수를 빌드 산출물에 문자열로 박아 넣습니다.
#   붙이는 순간 dist 안에 키가 평문으로 들어가 누구나 읽을 수 있습니다.
ANTHROPIC_API_KEY=

# ── 개발 모드 스위치 (VITE_ 가 붙지만 값이 켜짐/꺼짐뿐이라 새어도 상관없다) ──
# 기본은 전부 목이라 백엔드 없이 뜬다. 백엔드(:8080)를 띄웠으면 0 으로 real 을 켠다 —
# 인증·역량 사전·공고·경험·자소서 답변이 Spring 으로 간다(vite 프록시). AI(인테이크·초안)만 아직 vite 플러그인이다.
# 로그인 없이는 /api/** 가 전부 401 이라 real 모드의 첫 화면은 로그인 안내다.
# VITE_API_MOCK=0
# 목 지연(ms). 로딩 상태를 오래 보고 싶을 때. 기본 300~800 랜덤.
# VITE_API_MOCK_DELAY=3000
# 그 리소스만 500 을 던져 실패 화면을 본다. 쉼표로 여러 개.
# VITE_API_MOCK_FAIL=postings,ai
