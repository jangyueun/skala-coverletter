# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
# AI 키는 여기 없다 — ai/.env 의 ANTHROPIC_API_KEY 다. 프론트는 AI 를 직접 부르지 않는다(Spring → AI 서버).
#
# ⚠ VITE_ 접두사는 값이 빌드 산출물에 문자열로 박힌다. 켜짐/꺼짐 스위치에만 쓰고 비밀값에는 절대 붙이지 않는다.

# ── 개발 모드 스위치 ──
# 기본은 전부 목이라 백엔드 없이 뜬다. 백엔드(:8080)를 띄웠으면 0 으로 real 을 켠다 —
# 인증·역량 사전·공고·경험·자소서 답변·AI 전부 Spring 으로 간다(vite 프록시). AI(인테이크·초안)까지 쓰려면
# AI 서버(ai/, :8000)도 같이 떠 있어야 한다. 로그인 없이는 /api/** 가 전부 401 이라 real 모드의 첫 화면은 로그인 안내다.
# VITE_API_MOCK=0
# 목 지연(ms). 로딩 상태를 오래 보고 싶을 때. 기본 300~800 랜덤.
# VITE_API_MOCK_DELAY=3000
# 그 리소스만 500 을 던져 실패 화면을 본다. 쉼표로 여러 개.
# VITE_API_MOCK_FAIL=postings,ai
