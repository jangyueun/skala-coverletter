Project ai_service_final {
  database_type: 'PostgreSQL'
  note: '''
    Career DB와 물리적으로 분리된 AI Service DB.
    Kafka 없이 Career Backend → AI Service HTTP 호출 → DB 작업 상태 저장 → Career Backend/프론트 폴링으로 동작한다.
    external_* 값은 Career DB PK의 논리 참조이며 cross-database FK를 걸지 않는다.
  '''
}

Enum ai_task_type {
  POSTING_COMPETENCY_EXTRACTION
  EXPERIENCE_INTAKE
  MATCH
  DRAFT
}

Enum ai_task_status {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

Table ai_tasks {
  id                      bigint         [pk, increment]
  task_type               ai_task_type   [not null]
  status                  ai_task_status [not null, default: 'PENDING']

  external_user_id        bigint         [note: 'EXPERIENCE_INTAKE/MATCH/DRAFT 대상 사용자']
  external_job_posting_id bigint         [note: 'POSTING_COMPETENCY_EXTRACTION/MATCH 대상 공고']
  external_question_id    bigint         [note: 'DRAFT 대상 job_posting_questions.id']

  idempotency_key         varchar(128)   [not null, unique, note: 'task type + 대상 ID + input hash + 모델/프롬프트 버전 해시']
  input_hash              varchar(64)    [not null]
  model                   varchar(100)
  prompt_version          varchar(50)
  algorithm_version       varchar(50)

  request_payload         jsonb          [not null]
  result_payload          jsonb
  retry_count             integer        [not null, default: 0]
  total_tokens            integer
  latency_ms              integer
  error_code              varchar(100)
  error_message           text

  created_at              timestamptz    [not null, default: `now()`]
  started_at              timestamptz
  completed_at            timestamptz

  Indexes {
    (status, created_at)
    (task_type, external_user_id, status)
    (task_type, external_job_posting_id, status)
  }

  checks {
    `retry_count >= 0` [name: 'ck_ai_task_retry_count']
    `total_tokens IS NULL OR total_tokens >= 0` [name: 'ck_ai_task_total_tokens']
    `latency_ms IS NULL OR latency_ms >= 0` [name: 'ck_ai_task_latency']
    `(status = 'PENDING' AND started_at IS NULL AND completed_at IS NULL) OR (status = 'RUNNING' AND started_at IS NOT NULL AND completed_at IS NULL) OR (status IN ('COMPLETED','FAILED') AND started_at IS NOT NULL AND completed_at IS NOT NULL)` [name: 'ck_ai_task_timestamps']
  }

  note: '''
    필수 대상 규칙:
    - POSTING_COMPETENCY_EXTRACTION: external_job_posting_id
    - EXPERIENCE_INTAKE: external_user_id
    - MATCH: external_user_id + external_job_posting_id
    - DRAFT: external_user_id + external_question_id
    request_payload에는 DRAFT의 experienceIds 등 실행 시점 입력 스냅샷을 저장한다.
  '''
}

Table ai_task_attempts {
  id            bigint         [pk, increment]
  ai_task_id    bigint         [not null]
  attempt_no    integer        [not null]
  status        ai_task_status [not null]
  error_code    varchar(100)
  error_message text
  started_at    timestamptz    [not null]
  finished_at   timestamptz

  Indexes {
    (ai_task_id, attempt_no) [unique]
  }

  checks {
    `attempt_no > 0` [name: 'ck_ai_task_attempt_no']
  }
}

Ref: ai_task_attempts.ai_task_id > ai_tasks.id [delete: cascade]

TableGroup "AI 비동기 작업" {
  ai_tasks
  ai_task_attempts
}
