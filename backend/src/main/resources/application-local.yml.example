# 실제 비밀값은 `.env`에서 관리한다.
#
#   실행: set -a; source ../.env; set +a; ./gradlew bootRun

spring:
  datasource:
    url: ${SUPABASE_DB_URL}
    username: ${SUPABASE_DB_USERNAME}
    password: ${SUPABASE_DB_PASSWORD}
    driver-class-name: org.postgresql.Driver

careerfit:
  auth:
    client-id: ${SLACK_CLIENT_ID:}
    client-secret: ${SLACK_CLIENT_SECRET:}
    allowed-team-id: ${SLACK_ALLOWED_TEAM_ID:T089ENT4A2D}
    redirect-uri: ${SLACK_REDIRECT_URI:http://localhost:8080/api/auth/slack/callback}
    # http 에서는 Secure 쿠키가 브라우저에 저장되지 않는다. 로컬만 false.
    cookie-secure: ${SESSION_COOKIE_SECURE:false}

server:
  servlet:
    session:
      cookie:
        secure: ${SESSION_COOKIE_SECURE:false}
