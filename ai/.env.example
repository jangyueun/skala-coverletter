# ai/.env — Docker(compose 의 ai 서비스)와 로컬 uvicorn 이 둘 다 읽는다. 실제 값은 여기(ai/.env)에만 두고 커밋하지 않는다.

# 있으면 /ai/* 가 Claude 를 부른다(공고 분석 · 인테이크 · 초안). 없으면 Mock 그대로 — 키 없이도 뜬다.
ANTHROPIC_API_KEY=
# 기본 모델. 기능별 값을 비우면 이걸 쓴다(지금은 초안만).
AI_MODEL=claude-opus-5
# 기능별 모델·effort. 공고 분석과 인테이크는 사전에서 고르고 자료를 옮겨 적는 일이라 Sonnet 이 기본이고,
# 초안은 글 품질이 곧 결과라 Opus 다. effort 는 low·medium·high·xhigh·max — 모델을 바꾸기 전에 먼저 만지는 손잡이.
# AI_MODEL_POSTING_ANALYSIS=claude-sonnet-5
# AI_EFFORT_POSTING_ANALYSIS=medium
# AI_MODEL_EXPERIENCE_INTAKE=claude-sonnet-5
# AI_EFFORT_EXPERIENCE_INTAKE=high
# AI_MODEL_DRAFT=claude-opus-5
# AI_EFFORT_DRAFT=high
# 인테이크 advisor. 실행 모델(Sonnet)이 자료를 읽고, 후보를 나누거나 합칠지·역량 태깅이 애매할 때만 Opus 에게 묻는다.
# 기본 켜짐. 끄려면 0. 짝은 정해져 있다 — Sonnet 5 실행이면 advisor 는 Opus 5 이상, 아니면 400.
# AI_ADVISOR_EXPERIENCE_INTAKE=1
# AI_ADVISOR_MODEL=claude-opus-5
# AI_ADVISOR_MAX_USES=2
# AI_ADVISOR_MAX_TOKENS=4096
# 프롬프트 캐시 TTL(5m 또는 1h). 시스템 프롬프트와 역량 사전(약 5,700 토큰)이 호출마다 같아서 캐시한다.
# 작업이 띄엄띄엄 오면 1h, 5분 안에 계속 오면 5m 이 싸다. 맞았는지는 로그의 cache_read 로 본다.
# AI_CACHE_TTL=1h
# 1 이면 키가 있어도 Mock 으로 띄운다. 테스트는 conftest 가 자동으로 켠다 — 실제 API 를 부르지 않는다.
# AI_FORCE_MOCK=1

# 비워 두면 로컬 개발에서 인증을 검사하지 않습니다.
# 배포 환경에서는 반드시 긴 임의 문자열을 설정하고 Spring 서버(.env 의 AI_INTERNAL_TOKEN)에도 같은 값을 넣습니다.
AI_INTERNAL_TOKEN=
# 한 호출 상한(초). 인테이크는 web_fetch 로 자료를 여러 번 읽어 몇 분이 걸릴 수 있다.
AI_REQUEST_TIMEOUT_SECONDS=300
